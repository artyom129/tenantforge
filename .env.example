APP_ENV=development
DATABASE_URL=postgresql+asyncpg://tenantforge:tenantforge@localhost:5432/tenantforge
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-development-at-least-32-bytes
